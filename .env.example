# multivendor-ai-network-lab — environment template
# Copy to .env (gitignored) and fill in. NEVER commit real secrets — this repo is public.

# ─────────────────────────────────────────────────────────────────────────────
# API security (src/app.py Flask backend)
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret required by every privileged/mutating endpoint (POST/PUT/PATCH/DELETE:
# /api/run, /api/ai-command, /api/nornir/run, /api/remediate, /api/jmcp/execute,
# /api/chaos/bgp, /api/config-change/{propose,approve}, /api/config-drift,
# /api/change/closed-loop, and all other POST routes). Send it as the X-API-Key header.
# FAIL-CLOSED: if unset, those endpoints return HTTP 503 — never allow-by-default.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MVLAB_API_KEY=

# Bind address for the Flask backend. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 ONLY to deliberately expose the privileged API on all interfaces,
# and only together with a strong MVLAB_API_KEY and controlled network access.
MVLAB_HOST=127.0.0.1

# TCP port for the Flask backend (default 5757).
DCN_PORT=5757

# Comma-separated allowed CORS origins for /api/* (default = local dashboard origins).
# The dashboard is served same-origin, so '*' is never needed.
MVLAB_CORS_ORIGINS=http://localhost:5757,http://localhost:8080,http://127.0.0.1:5757,http://127.0.0.1:8080

# Optional override for the repo-root anchor (inventory, demo, network-lab, audit log).
# MVLAB_REPO_ROOT=

# ─────────────────────────────────────────────────────────────────────────────
# Phase 6 — event-initiated auto-remediation (src/auto_remediate.py)
# ─────────────────────────────────────────────────────────────────────────────
# Background loop interval in seconds (0 = endpoints registered, loop OFF — default).
MVLAB_AUTO_REMEDIATE_S=0
# Simulate-only mode (plan/log, never execute) when set truthy.
# MVLAB_AUTO_REMEDIATE_SIMULATE=1

# ─────────────────────────────────────────────────────────────────────────────
# FRR lab CLI proxy (network-lab/cli_proxy.py)
# ─────────────────────────────────────────────────────────────────────────────
# HTTP Basic password (user=admin) for the vtysh proxy. REQUIRED — fail-closed if unset.
CLI_PROXY_PASSWORD=
CLI_PROXY_HOST=127.0.0.1
CLI_PROXY_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# SSH / device access (src/app.py)
# ─────────────────────────────────────────────────────────────────────────────
# SSH mode: "pkcs11" = YubiKey PIV (default), "key" = key file.
# Lab-only / CI: set DCN_SSH_MODE=key so boot does not try PKCS#11.
DCN_SSH_MODE=pkcs11
# Required when DCN_SSH_MODE=pkcs11. There is NO baked-in PIN default — if this
# is unset, _pkcs11_init() raises and the process falls back to key mode
# (src/app.py). Never put a real PIN in a committed file.
# DCN_PKCS11_PIN=
# DCN_PKCS11_LIB=/usr/local/lib/libykcs11.dylib
# DCN_SSH_KEY=           # service-account key path (used when SSH_MODE=key)
# DCN_SSH_USER=netadmin1
# DCN_SSH_TIMEOUT=30
# DCN_FRR_SSH_KEY=       # lab FRR key path (defaults to network-lab/ssh-keys/lab_key)
# Harden both in any non-laptop deployment:
DCN_SSH_STRICT_HOST_KEY=false
DCN_VERIFY_SSL=false
# Optional FRR lab container password (fail-closed when unset):
FRR_DEFAULT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Optional inventory sources (off by default; CSV files are not in this repo)
# ─────────────────────────────────────────────────────────────────────────────
# DCN_SECURECRT_CSV=
# DCN_NETBOX_CSV=

# ─────────────────────────────────────────────────────────────────────────────
# LLM / integrations (optional)
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=     # Claude fallback — load from a secrets manager or ~/.env
# LLM_ENABLED=false
# LLM_PROVIDER=local     # local | claude | claude-only
# LLM_MODEL=
# OLLAMA_URL=http://localhost:11434
# MODEL_RUNNER_URL=http://localhost:12434

# ─────────────────────────────────────────────────────────────────────────────
# Integrations (optional)
# ─────────────────────────────────────────────────────────────────────────────
# LIBRENMS_URL=
# LIBRENMS_TOKEN=
# INFLUXDB_URL=
# INFLUXDB_TOKEN=
# JMCP_URL=http://localhost:30030
# JMCP_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# AEGIS preflight (optional, auto-detected)
# ─────────────────────────────────────────────────────────────────────────────
# AEGIS_LLM_URL=http://localhost:11434
# AEGIS_LLM_MODEL=gemma4:latest
# AEGIS_BASE=http://127.0.0.1:5757
# AEGIS_CLAB_MODE=auto   # auto | docker | binary
